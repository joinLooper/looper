{
  "name": "looper",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "db:migrate": "pnpm --filter @looper/api db:migrate",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "pnpm run test:api && pnpm run test:frontend && pnpm run test:postgres",
    "test:mvp": "pnpm --filter @looper/api test",
    "qa:player-ui": "node scripts/qa-player-ui.mjs",
    "qa:resident-content": "node scripts/qa-resident-content.mjs",
    "qa:resident-guidance": "node scripts/qa-resident-guidance.mjs",
    "qa:runtime-assembly": "node scripts/qa-runtime-assembly.mjs",
    "qa:forest-runtime": "node scripts/qa-forest-logical-runtime.mjs",
    "qa:unified-runtime": "node scripts/qa-unified-runtime.mjs",
    "qa:pg-readiness": "node --import tsx scripts/w1c0-pg-adapter-readiness.mjs",
    "format": "prettier --write .",
    "test:api": "pnpm --filter @looper/api test",
    "test:async-readonly": "pnpm --filter @looper/api test:async-readonly",
    "test:async-player-state": "node --import tsx --test --test-concurrency=1 scripts/test-w1c1c-player-state.mjs",
    "test:legacy-atomicity": "node --import tsx --test --test-concurrency=1 scripts/test-w1c1d-legacy-atomicity.mjs",
    "test:energy-extraction": "node --import tsx --test --test-concurrency=1 scripts/w1c1c-extraction.spec.mjs scripts/w1c1c-transaction-boundary.spec.mjs",
    "test:frontend": "node scripts/test-frontend.mjs",
    "qa:capture-runtime": "node scripts/capture-runtime-assembly.mjs",
    "test:postgres": "node scripts/test-postgres.mjs",
    "test:async-foundation": "node --import tsx scripts/test-w1c1-async-foundation.mjs",
    "qa:async-mvp-load": "node --import tsx scripts/test-w1c1a1-mvp-load.mjs",
    "test:auth01a": "node --import tsx --test --test-concurrency=1 scripts/test-auth01a.mjs",
    "auth:google:migrate": "pnpm --filter @looper/api exec tsx src/migrate-merchant-google.ts",
    "test:auth01a1": "node --import tsx --test --test-concurrency=1 scripts/test-auth01a1.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "prettier": "latest",
    "puppeteer": "24.37.5",
    "tsx": "4.23.1",
    "turbo": "latest",
    "typescript": "6.0.3"
  }
}

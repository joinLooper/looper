    ],
    "knowledge_entry.unlock": [
      "knowledge_entry.active"
    ],
    "question.initial": [
      "question.submitting"
    ],
    "question.submitting": [
      "question.correct",
      "question.wrong",
      "question.error"
    ],
    "question.correct": [
      "question.completed"
    ],
    "question.wrong": [
      "question.completed"
    ],
    "question.completed": [
      "question.already_completed"
    ],
    "question.error": [
      "question.initial"
    ],
    "duplicate_submit": "question.already_completed",
    "submitting_close": "disabled",
    "completed_options": "disabled",
    "error_reward": "none",
    "error_hud_update": "none"

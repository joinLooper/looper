# Default OFF. No real credential is included. GOOGLE_MERCHANT_CLIENT_ID is public.
LOOPER_MERCHANT_GOOGLE_ENABLED=false
GOOGLE_MERCHANT_CLIENT_ID=
LOOPER_MERCHANT_APP_URL=http://localhost:3002
# Explicit isolated SQLite file for: pnpm auth:google:migrate
LOOPER_DATABASE_PATH=output/auth01a/local.sqlite
# Production requires HTTPS, a real Google Web client with this exact authorized
# JavaScript origin, and same-site API/Web hosting for existing SameSite=Lax cookies.
# No Google client secret, refresh token, or provider access token is used.

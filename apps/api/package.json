{
  "name": "@looper/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --rootDir src",
    "bootstrap:platform-admin": "tsx src/bootstrap-platform-admin.ts",
    "db:migrate": "tsx src/migrate.ts",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit && tsc -p tsconfig.parity.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.parity.json",
    "test": "tsx --test src/**/*.test.ts",
    "test:async-readonly": "tsx --test --test-concurrency=1 src/async-mission-read-store.slice.spec.ts test-parity/async-mission.slice.spec.ts"
  },
  "dependencies": {
    "@fastify/cors": "latest",
    "@looper/types": "workspace:*",
    "fastify": "latest",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/pg": "8.15.5",
    "tsx": "latest",
    "typescript": "6.0.3"
  }
}
